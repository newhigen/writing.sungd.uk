---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
  kind: string
}

const { post, kind } = Astro.props

function excerpt(body = '') {
  const lines = body
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l && !/^(#|>|!|<|\||```|---)/.test(l))
    .map((l) => l.replace(/^[-*]\s+/, ''))
  const text = lines
    .slice(0, 3)
    .join(' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`]/g, '')
  return text.length > 180 ? text.slice(0, 180).trimEnd() + '…' : text
}

const date = post.data.pubDate.toISOString().slice(0, 10)
---

<section class="featured only-featured" data-id={post.id}>
  <p class="f-meta"><span>{kind}</span><span>{date}</span></p>
  <h2 class="f-title"><a href={`/${post.id}/`}>{post.data.title}</a></h2>
  <p class="f-x">{excerpt(post.body)}</p>
</section>

<style>
  .featured {
    display: none;
  }

  .f-meta {
    margin: 0 0 0.35rem;
    display: flex;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .f-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .f-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .f-title a:hover {
    box-shadow: 0 1px 0 var(--text-tertiary);
  }

  .f-x {
    margin: 0.6rem 0 0;
    color: var(--text-secondary);
    max-width: 34rem;
    line-height: 1.7;
  }
</style>
