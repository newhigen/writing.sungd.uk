---
import type { CollectionEntry } from 'astro:content'
import { isoDate, excerpt } from '@/utils/home'
import KindTitle from '@/components/ui/KindTitle.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
  lead: number
  tail: number
}

const { posts, lead, tail } = Astro.props

// 날짜는 왼쪽 여백 칸에 월.일, 해가 바뀌는 자리에만 연도를 둔다
const dated = posts.map((post, i) => {
  const iso = isoDate(post.data.pubDate)
  const [y, m, d] = iso.split('-')
  const prevYear = i > 0 ? isoDate(posts[i - 1].data.pubDate).slice(0, 4) : ''
  return { post, iso, year: y, yearStart: y !== prevYear, short: `${m}.${d}` }
})
const leads = dated.slice(0, lead)
const tails = dated.slice(lead)
const rest = tails.length - tail
---

<section class="sentences">
  {
    leads.map(({ post, iso, year, yearStart, short }) => (
      <>
        {yearStart && <p class="yr">{year}</p>}
        <article class="entry">
          <time class="gutter" datetime={iso}>
            {short}
          </time>
          <div>
            <h2 class="title">
              <a href={`/${post.id}/`}>
                <KindTitle title={post.data.title} review={post.data.category === '책'} />
              </a>
            </h2>
            <p class="x">{excerpt(post.body)}</p>
          </div>
        </article>
      </>
    ))
  }
  {lead > 0 && <slot name="mid" />}
  {lead > 0 && <h2 class="tail-head">그 밖의 글</h2>}
  <ul class="tail">
    {
      tails.map(({ post, iso, year, yearStart, short }, i) => (
        <>
          {yearStart && (
            <li class="yr-li" hidden={i >= tail}>
              {year}
            </li>
          )}
          <li hidden={i >= tail}>
            <a href={`/${post.id}/`}>
              <time class="gutter" datetime={iso}>
                {short}
              </time>
              <span class="t">
                <KindTitle title={post.data.title} review={post.data.category === '책'} />
              </span>
            </a>
          </li>
        </>
      ))
    }
  </ul>
  {
    rest > 0 && (
      <button class="more" type="button" data-more>
        {rest}편 더 ›
      </button>
    )
  }
  {lead === 0 && <slot name="mid" />}
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-more]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.parentElement?.querySelectorAll('.tail li[hidden]').forEach((li) => li.removeAttribute('hidden'))
        btn.remove()
      })
    })

    // 30일 안에 올린 글은 날짜 대신 「오늘」「어제」「N일 전」으로 적는다. 빌드는 가끔이라 보는 날 기준으로 센다
    const day = 864e5
    const today = new Date().setHours(0, 0, 0, 0)
    document.querySelectorAll('.sentences time[datetime]').forEach((t) => {
      const [y, m, d] = (t.getAttribute('datetime') || '').slice(0, 10).split('-').map(Number)
      const n = Math.round((today - new Date(y, m - 1, d).getTime()) / day)
      if (n < 0 || n >= 30) return
      t.textContent = n === 0 ? '오늘' : n === 1 ? '어제' : `${n}일 전`
      t.classList.add('is-new')
    })
  })
</script>

<style>
  .sentences {
    --gutter: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.9rem;
    margin-bottom: 3rem;
  }

  .yr,
  .yr-li {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--num);
    font-variant-numeric: tabular-nums;
  }

  .yr {
    margin: 0 0 -1.4rem;
  }

  .entry {
    display: grid;
    grid-template-columns: var(--gutter) minmax(0, 1fr);
    align-items: baseline;
  }

  .gutter {
    flex: none;
    width: var(--gutter);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-family: var(--num);
    font-variant-numeric: tabular-nums;
  }

  .entry .title {
    margin: 0;
    font-family: var(--head);
    font-size: 1.125rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.4;
  }

  .entry .title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .entry .title a:hover {
    color: var(--accent);
  }

  .entry .x {
    margin: 0.3rem 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tail-head {
    margin: 1rem 0 0 var(--gutter);
    font-family: var(--head);
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
  }

  .gutter.is-new {
    color: var(--accent);
  }

  .tail {
    list-style: none;
    margin: -1rem 0 0;
    padding: 0;
  }

  .tail li[hidden] {
    display: none;
  }

  .tail .yr-li {
    margin: 0.9rem 0 0.2rem;
  }

  .tail a {
    display: flex;
    align-items: baseline;
    padding: 0.28rem 0;
    color: var(--text-primary);
    text-decoration: none;
  }

  .tail .t {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tail a:hover .t {
    color: var(--accent);
  }

  .more {
    align-self: flex-start;
    margin: -1rem 0 0 var(--gutter);
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .more:hover {
    color: var(--text-primary);
  }
</style>
