---
import type { CollectionEntry } from 'astro:content'
import type { Book } from '@/utils/books'
import { kindOf } from '@/utils/home'

interface Props {
  posts: CollectionEntry<'posts'>[]
  books: Book[]
  open: number
}

const { posts, books, open } = Astro.props

const monthKey = (d: Date) => `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`

const months = new Map<string, { posts: CollectionEntry<'posts'>[]; books: Book[] }>()
for (const post of posts) {
  const key = monthKey(post.data.pubDate)
  if (!months.has(key)) months.set(key, { posts: [], books: [] })
  months.get(key)!.posts.push(post)
}
for (const book of books) {
  const key = `${book.year}-${String(book.month).padStart(2, '0')}`
  if (!months.has(key)) months.set(key, { posts: [], books: [] })
  months.get(key)!.books.push(book)
}
const keys = [...months.keys()].sort().reverse()
const rest = keys.length - open
---

<section class="journal">
  {
    keys.map((key, i) => {
      const [y, m] = key.split('-')
      const { posts: ps, books: bs } = months.get(key)!
      return (
        <article class="month" hidden={i >= open}>
          <h2 class="month-head">
            <span class="ym">
              {y}년 {Number(m)}월
            </span>
            {bs.length > 0 && (
              <span class="read">
                읽은 책 {bs.length}권 — {bs.map((b) => b.title).join(', ')}
              </span>
            )}
            {bs.length === 0 && <span class="read none">읽은 책 없음</span>}
          </h2>
          {ps.length > 0 && (
            <ul class="month-posts">
              {ps.map((p) => (
                <li>
                  <a href={`/${p.id}/`}>
                    <span class="k">{kindOf(p)}</span>
                    <span class="t">{p.data.title}</span>
                    <span class="d">{p.data.pubDate.getUTCDate()}일</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </article>
      )
    })
  }
  {
    rest > 0 && (
      <button class="more" type="button" data-more-months>
        지난 {rest}달 더 ›
      </button>
    )
  }
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-more-months]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.parentElement?.querySelectorAll('.month[hidden]').forEach((m) => m.removeAttribute('hidden'))
        btn.remove()
      })
    })
  })
</script>

<style>
  .journal {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .month[hidden] {
    display: none;
  }

  .month-head {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-regular);
    line-height: 1.7;
  }

  .month-head .ym {
    font-weight: var(--font-weight-bold);
    margin-right: 0.6rem;
  }

  .month-head .read {
    color: var(--text-secondary);
  }

  .month-head .read.none {
    color: var(--text-tertiary);
  }

  .month-posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .month-posts a {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.28rem 0;
    color: var(--text-primary);
    text-decoration: none;
  }

  .month-posts .k {
    flex: none;
    width: 2.1rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .month-posts .t {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .month-posts a:hover .t {
    box-shadow: 0 1px 0 var(--text-tertiary);
  }

  .month-posts .d {
    flex: none;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .more {
    align-self: flex-start;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .more:hover {
    color: var(--text-primary);
  }
</style>
