---
import Drawer from '@/components/layout/Drawer.astro'
import Footer from '@/components/layout/Footer.astro'
import GradientMask from '@/components/ui/GradientMask.astro'
import VariantSwitcher from '@/components/layout/VariantSwitcher.astro'
import { themeConfig } from '@/config'

interface Props {
  active?: string
}

const { active } = Astro.props
---

<div class="frame">
  <GradientMask />
  <Drawer active={active} />
  <div class="frame-main">
    <main>
      <slot />
    </main>
    {themeConfig.general.footer && <Footer />}
  </div>
  <VariantSwitcher />
</div>

<style>
  .frame {
    flex: 1;
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    column-gap: 2.125rem;
  }

  .frame-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .frame-main main {
    flex: 1;
  }

  @media (max-width: 640px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }
  }
</style>
