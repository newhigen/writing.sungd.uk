---
import Drawer from '@/components/layout/Drawer.astro'
import Footer from '@/components/layout/Footer.astro'
import GradientMask from '@/components/ui/GradientMask.astro'
import PreviewSwitcher from '@/components/layout/PreviewSwitcher.astro'
import { themeConfig } from '@/config'

interface Props {
  active?: string
}

const { active } = Astro.props
---

<div class="frame">
  <GradientMask />
  <aside class="frame-side">
    <Drawer active={active} />
    <slot name="aside" />
  </aside>
  <div class="frame-main">
    <main>
      <slot />
    </main>
    {themeConfig.general.footer && <Footer />}
  </div>
  <PreviewSwitcher />
</div>

<style>
  .frame {
    flex: 1;
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    column-gap: 2.5rem;
  }

  .frame-side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-self: start;
  }

  .frame-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .frame-main main {
    flex: 1;
  }

  /* 넓은 화면: 글 칸을 화면 가운데에 두고 차림표·히트맵은 왼쪽 여백에 건다 */
  @media (min-width: 1200px) {
    .frame {
      display: block;
      position: relative;
    }

    .frame-side {
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(100% + 2.5rem);
      width: 13rem;
    }
  }

  @media (max-width: 640px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
    }

    .frame-side {
      gap: 1.25rem;
    }
  }
</style>

<style is:global>
  @media (min-width: 1200px) {
    body[data-centered='true'] {
      max-width: 34.5rem !important;
    }
  }
</style>
