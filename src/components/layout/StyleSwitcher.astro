---
// 임시: 글꼴 시안 전환기. 색은 「책장」으로 고정. 고르면 지운다.
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700&family=Nanum+Myeongjo:wght@800&family=Gowun+Batang:wght@700&family=IBM+Plex+Sans+KR:wght@400;700&family=JetBrains+Mono&display=swap"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/sun-typeface/SUIT@2/fonts/variable/woff2/SUIT-Variable.css" />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css"
/>

<div class="sw" aria-label="글꼴 시안 전환">
  <button data-f="">지금</button>
  <button data-f="1">ㄱ</button>
  <button data-f="6">ㅂ</button>
  <button data-f="7">ㅅ</button>
  <button data-f="8">ㅇ</button>
  <button data-f="9">ㅈ</button>
  <button data-f="10">ㅊ</button>
</div>

<script is:inline>
  ;(() => {
    const q = new URLSearchParams(location.search).get('f')
    let f = q !== null ? q : localStorage.getItem('sd-f') || ''
    const apply = () => {
      if (f) document.documentElement.dataset.f = f
      else delete document.documentElement.dataset.f
      document.querySelectorAll('.sw button').forEach((b) => b.classList.toggle('on', b.dataset.f === f))
    }
    apply()
    document.addEventListener('astro:page-load', () => {
      apply()
      document.querySelectorAll('.sw button').forEach((b) =>
        b.addEventListener('click', () => {
          f = b.dataset.f
          localStorage.setItem('sd-f', f)
          apply()
        })
      )
    })
  })()
</script>

<style is:global>
  .sw {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    z-index: 9;
    font-family: system-ui, sans-serif;
  }
  .sw button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 0.3rem;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .sw button.on {
    background: var(--text-primary);
    color: var(--bg);
  }

  /* ── 색: 책장 (종이·먹, 청록 하나) ── */
  :root:not(.dark) {
    --bg: #f7f5f0;
    --text-primary: #1f1d1a;
    --text-secondary: #77716a;
    --text-tertiary: #c9c3b8;
    --border: #e6e1d8;
    --accent: #1f5f5b;
    --selection: rgba(31, 95, 91, 0.15);
    --code-bg: rgba(31, 29, 26, 0.05);
    --mark: #ece5c4;
    --astro-code-background: rgba(31, 29, 26, 0.04);
  }
  :root {
    --mono: 'JetBrains Mono', 'SF Mono', monospace;
  }
  :root.dark {
    --bg: #1b1917;
    --text-primary: #e8e3da;
    --text-secondary: #8f887d;
    --text-tertiary: #4a453f;
    --border: #2e2a26;
    --accent: #7fc4bd;
    --selection: rgba(127, 196, 189, 0.2);
    --code-bg: rgba(255, 255, 255, 0.05);
    --mark: #4d4a2e;
    --astro-code-background: rgba(255, 255, 255, 0.04);
  }
  .prose a,
  .drawer-links a.on,
  .tail a:hover .t {
    color: var(--accent);
  }
  .entry .title a:hover {
    color: var(--accent);
    box-shadow: none;
  }

  @font-face {
    font-family: 'Maru Buri';
    font-weight: 700;
    font-display: swap;
    src: url(https://hangeul.pstatic.net/hangeul_static/webfont/MaruBuri/MaruBuri-Bold.woff2) format('woff2');
  }

  /* ── 글꼴: --head 제목(명조), --sans 본문(고딕) ── */
  :root[data-f] {
    --head-weight: 700;
    --head-spacing: 0;
  }
  /* ㄱ 함렛 + 프리텐다드 */
  :root[data-f='1'] {
    --head: 'Hahmlet', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
  }
  /* ㅂ 함렛 세미볼드 + SUIT */
  :root[data-f='6'] {
    --head: 'Hahmlet', serif;
    --sans: 'SUIT Variable', sans-serif;
    --head-weight: 600;
  }
  /* ㅅ 마루 부리 + 프리텐다드 */
  :root[data-f='7'] {
    --head: 'Maru Buri', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
  }
  /* ㅇ 나눔명조 엑스트라볼드 + 원티드 산스 */
  :root[data-f='8'] {
    --head: 'Nanum Myeongjo', serif;
    --sans: 'Wanted Sans Variable', sans-serif;
    --head-weight: 800;
    --head-spacing: -0.01em;
  }
  /* ㅈ 고운바탕 + 프리텐다드 */
  :root[data-f='9'] {
    --head: 'Gowun Batang', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
  }
  /* ㅊ 함렛 + IBM Plex Sans KR */
  :root[data-f='10'] {
    --head: 'Hahmlet', serif;
    --sans: 'IBM Plex Sans KR', sans-serif;
  }
  :root[data-f] .prose .title h1,
  :root[data-f] .prose h1,
  :root[data-f] .prose h2,
  :root[data-f] .prose h3,
  :root[data-f] .entry .title,
  :root[data-f] .tail-head,
  :root[data-f] .page-title,
  :root[data-f] .drawer-me,
  :root[data-f] .reading-head a {
    font-family: var(--head);
    font-weight: var(--head-weight);
    letter-spacing: var(--head-spacing);
  }
</style>
