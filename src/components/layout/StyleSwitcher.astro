---
// 임시: 본문 리듬·날짜 표기 시안 전환기. 색은 책장, 글꼴은 ㅈ(고운바탕+프리텐다드)으로 고정. 고르면 지운다.
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@700&family=JetBrains+Mono&display=swap"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<div class="sw" aria-label="리듬 시안 전환">
  <button data-r="">지금</button>
  <button data-r="1">가</button>
  <button data-r="2">나</button>
  <button data-r="3">다</button>
  <button data-r="4">라</button>
</div>

<script is:inline>
  ;(() => {
    const q = new URLSearchParams(location.search).get('r')
    let r = q !== null ? q : localStorage.getItem('sd-r') || ''
    const apply = () => {
      if (r) document.documentElement.dataset.r = r
      else delete document.documentElement.dataset.r
      document.querySelectorAll('.sw button').forEach((b) => b.classList.toggle('on', b.dataset.r === r))
    }
    apply()
    document.addEventListener('astro:page-load', () => {
      apply()
      document.querySelectorAll('.sw button').forEach((b) =>
        b.addEventListener('click', () => {
          r = b.dataset.r
          localStorage.setItem('sd-r', r)
          apply()
        })
      )
    })
  })()
</script>

<style is:global>
  .sw {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    z-index: 9;
    font-family: system-ui, sans-serif;
  }
  .sw button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 0.3rem;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .sw button.on {
    background: var(--text-primary);
    color: var(--bg);
  }

  /* ── 색: 책장 ── */
  :root:not(.dark) {
    --bg: #f7f5f0;
    --text-primary: #1f1d1a;
    --text-secondary: #77716a;
    --text-tertiary: #aea79c;
    --border: #e6e1d8;
    --accent: #1f5f5b;
    --selection: rgba(31, 95, 91, 0.15);
    --code-bg: rgba(31, 29, 26, 0.05);
    --mark: #ece5c4;
    --astro-code-background: rgba(31, 29, 26, 0.04);
  }
  :root.dark {
    --bg: #1b1917;
    --text-primary: #e8e3da;
    --text-secondary: #8f887d;
    --text-tertiary: #615a51;
    --border: #2e2a26;
    --accent: #7fc4bd;
    --selection: rgba(127, 196, 189, 0.2);
    --code-bg: rgba(255, 255, 255, 0.05);
    --mark: #4d4a2e;
    --astro-code-background: rgba(255, 255, 255, 0.04);
  }
  .prose a,
  .drawer-links a.on,
  .tail a:hover .t {
    color: var(--accent);
  }
  .entry .title a:hover {
    color: var(--accent);
    box-shadow: none;
  }

  /* ── 글꼴: ㅈ 고운바탕 제목 + 프리텐다드 본문 ── */
  :root {
    --head: 'Gowun Batang', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
    --mono: 'JetBrains Mono', 'SF Mono', monospace;
  }
  .prose .title h1,
  .prose h1,
  .prose h2,
  .prose h3,
  .entry .title,
  .tail-head,
  .page-title,
  .drawer-me,
  .reading-head a {
    font-family: var(--head);
    font-weight: 700;
  }

  .post-foot-date {
    display: none;
  }
  html:root[data-r] .prose .title .date * {
    font-size: inherit;
  }

  /* ════ 가 · 조용히 — 16px/1.8, 날짜는 제목 오른쪽에 흐리게 ════ */
  html:root[data-r='1'] {
    --font-size-m: 1rem;
  }
  html:root[data-r='1'] body,
  html:root[data-r='1'] .prose p,
  html:root[data-r='1'] .prose ul {
    line-height: 1.8;
  }
  html:root[data-r='1'] .prose p {
    margin: 0.7em 0;
  }
  html:root[data-r='1'] .sentences {
    gap: 2rem;
  }
  html:root[data-r='1'] .entry .meta,
  html:root[data-r='1'] .tail .k {
    display: none;
  }
  html:root[data-r='1'] .entry .title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  html:root[data-r='1'] .entry .side {
    display: inline;
    margin-left: auto;
    flex: none;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='1'] .tail .d {
    display: none;
  }
  html:root[data-r='1'] .tail .dd {
    display: inline;
    flex: none;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='1'] .prose .title .date {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    opacity: 1;
  }
  html:root[data-r='1'] .prose .title .reading-time {
    display: none;
  }

  /* ════ 나 · 넉넉히 — 17px/1.9, 날짜는 글 끝에 달 단위로 ════ */
  html:root[data-r='2'] {
    --font-size-m: 1.0625rem;
  }
  html:root[data-r='2'] body,
  html:root[data-r='2'] .prose p,
  html:root[data-r='2'] .prose ul {
    line-height: 1.9;
  }
  html:root[data-r='2'] .prose p {
    margin: 1em 0;
  }
  html:root[data-r='2'] .sentences {
    gap: 2.75rem;
  }
  html:root[data-r='2'] .entry .title {
    font-size: 1.3125rem;
  }
  html:root[data-r='2'] .entry .x {
    margin-top: 0.5rem;
    -webkit-line-clamp: 3;
  }
  html:root[data-r='2'] .entry .meta,
  html:root[data-r='2'] .tail .k,
  html:root[data-r='2'] .tail .d {
    display: none;
  }
  html:root[data-r='2'] .entry .foot {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
  html:root[data-r='2'] .tail .yr-li:not([hidden]) {
    display: block;
    margin: 1rem 0 0.25rem;
  }
  html:root[data-r='2'] .tail .yr {
    display: inline;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='2'] .tail a {
    padding: 0.4rem 0;
  }
  html:root[data-r='2'] .prose .title .date {
    display: none;
  }
  html:root[data-r='2'] .post-foot-date {
    display: block;
    margin-top: 3rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
  }

  /* ════ 다 · 여백에 — 16px/1.85, 날짜는 왼쪽 여백 칸에 월.일, 해가 바뀔 때만 연도 ════ */
  html:root[data-r='3'] {
    --font-size-m: 1rem;
  }
  html:root[data-r='3'] body,
  html:root[data-r='3'] .prose p,
  html:root[data-r='3'] .prose ul {
    line-height: 1.85;
  }
  html:root[data-r='3'] .prose p {
    margin: 0.8em 0;
  }
  html:root[data-r='3'] .sentences {
    gap: 1.9rem;
  }
  html:root[data-r='3'] .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    align-items: baseline;
  }
  html:root[data-r='3'] .entry .gutter,
  html:root[data-r='3'] .tail .g {
    display: block;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='3'] .entry .meta,
  html:root[data-r='3'] .tail .k,
  html:root[data-r='3'] .tail .d {
    display: none;
  }
  html:root[data-r='3'] .sentences > .yr {
    display: block;
    margin: 0 0 -1.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='3'] .tail .yr-li:not([hidden]) {
    display: block;
    margin: 0.9rem 0 0.2rem;
  }
  html:root[data-r='3'] .tail .yr {
    display: inline;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
  html:root[data-r='3'] .tail a {
    gap: 0;
  }
  html:root[data-r='3'] .tail .g {
    flex: none;
    width: 3rem;
  }
  html:root[data-r='3'] .tail-head,
  html:root[data-r='3'] .more {
    margin-left: 3rem;
  }
  html:root[data-r='3'] .prose .title {
    display: flex;
    flex-direction: column;
  }
  html:root[data-r='3'] .prose .title .date {
    order: -1;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    opacity: 1;
  }
  html:root[data-r='3'] .prose .title .reading-time {
    display: none;
  }

  /* ════ 라 · 거의 없이 — 16.5px/1.8, 목록엔 날짜 대신 연도 구분만, 글엔 끝에 한 줄 ════ */
  html:root[data-r='4'] {
    --font-size-m: 1.03125rem;
  }
  html:root[data-r='4'] body,
  html:root[data-r='4'] .prose p,
  html:root[data-r='4'] .prose ul {
    line-height: 1.8;
  }
  html:root[data-r='4'] .prose p {
    margin: 0.85em 0;
  }
  html:root[data-r='4'] .sentences {
    gap: 2.25rem;
  }
  html:root[data-r='4'] .entry .meta,
  html:root[data-r='4'] .tail .k,
  html:root[data-r='4'] .tail .d {
    display: none;
  }
  html:root[data-r='4'] .sentences > .yr {
    display: block;
    margin: 0 0 -1.25rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  html:root[data-r='4'] .tail .yr-li:not([hidden]) {
    display: block;
    margin: 1.1rem 0 0.2rem;
  }
  html:root[data-r='4'] .tail .yr {
    display: inline;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }
  html:root[data-r='4'] .prose .title .date {
    display: none;
  }
  html:root[data-r='4'] .post-foot-date {
    display: block;
    margin-top: 3.5rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }
</style>
