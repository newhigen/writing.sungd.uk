---
// 임시: 글꼴 시안 전환기. 색은 「책장」으로 고정. 고르면 지운다.
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@400;700&family=Noto+Serif+KR:wght@400;700&family=Gowun+Batang:wght@400;700&family=Gowun+Dodum&family=Song+Myung&family=IBM+Plex+Sans+KR:wght@400;700&family=JetBrains+Mono&display=swap"
/>
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<div class="sw" aria-label="글꼴 시안 전환">
  <button data-f="">지금</button>
  <button data-f="1">ㄱ</button>
  <button data-f="2">ㄴ</button>
  <button data-f="3">ㄷ</button>
  <button data-f="4">ㄹ</button>
  <button data-f="5">ㅁ</button>
</div>

<script is:inline>
  ;(() => {
    const q = new URLSearchParams(location.search).get('f')
    let f = q !== null ? q : localStorage.getItem('sd-f') || ''
    const apply = () => {
      if (f) document.documentElement.dataset.f = f
      else delete document.documentElement.dataset.f
      document.querySelectorAll('.sw button').forEach((b) => b.classList.toggle('on', b.dataset.f === f))
    }
    apply()
    document.addEventListener('astro:page-load', () => {
      apply()
      document.querySelectorAll('.sw button').forEach((b) =>
        b.addEventListener('click', () => {
          f = b.dataset.f
          localStorage.setItem('sd-f', f)
          apply()
        })
      )
    })
  })()
</script>

<style is:global>
  .sw {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    z-index: 9;
    font-family: system-ui, sans-serif;
  }
  .sw button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 0.3rem;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .sw button.on {
    background: var(--text-primary);
    color: var(--bg);
  }

  /* ── 색: 책장 (종이·먹, 청록 하나) ── */
  :root:not(.dark) {
    --bg: #f7f5f0;
    --text-primary: #1f1d1a;
    --text-secondary: #77716a;
    --text-tertiary: #c9c3b8;
    --border: #e6e1d8;
    --accent: #1f5f5b;
    --selection: rgba(31, 95, 91, 0.15);
    --code-bg: rgba(31, 29, 26, 0.05);
    --mark: #ece5c4;
    --astro-code-background: rgba(31, 29, 26, 0.04);
  }
  :root {
    --mono: 'JetBrains Mono', 'SF Mono', monospace;
  }
  :root.dark {
    --bg: #1b1917;
    --text-primary: #e8e3da;
    --text-secondary: #8f887d;
    --text-tertiary: #4a453f;
    --border: #2e2a26;
    --accent: #7fc4bd;
    --selection: rgba(127, 196, 189, 0.2);
    --code-bg: rgba(255, 255, 255, 0.05);
    --mark: #4d4a2e;
    --astro-code-background: rgba(255, 255, 255, 0.04);
  }
  .prose a,
  .drawer-links a.on,
  .tail a:hover .t {
    color: var(--accent);
  }
  .entry .title a:hover {
    color: var(--accent);
    box-shadow: none;
  }

  /* ── 글꼴 다섯 벌: --head 제목, --sans 본문 ── */
  :root[data-f='1'] {
    --head: 'Hahmlet', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
    --head-weight: 700;
    --head-spacing: 0;
  }
  :root[data-f='2'] {
    --head: 'Noto Serif KR', serif;
    --sans: 'Pretendard Variable', Pretendard, sans-serif;
    --head-weight: 700;
    --head-spacing: -0.01em;
  }
  :root[data-f='3'] {
    --head: 'Pretendard Variable', Pretendard, sans-serif;
    --sans: 'Noto Serif KR', serif;
    --head-weight: 800;
    --head-spacing: -0.025em;
    --font-size-m: 1rem;
  }
  :root[data-f='4'] {
    --head: 'Gowun Batang', serif;
    --sans: 'Gowun Dodum', sans-serif;
    --head-weight: 700;
    --head-spacing: 0;
    --font-size-m: 1rem;
  }
  :root[data-f='5'] {
    --head: 'Song Myung', serif;
    --sans: 'IBM Plex Sans KR', sans-serif;
    --head-weight: 400;
    --head-spacing: 0;
  }
  :root[data-f='3'] body,
  :root[data-f='4'] body {
    line-height: 1.85;
  }
  :root[data-f] .prose .title h1,
  :root[data-f] .prose h1,
  :root[data-f] .prose h2,
  :root[data-f] .prose h3,
  :root[data-f] .entry .title,
  :root[data-f] .tail-head,
  :root[data-f] .page-title,
  :root[data-f] .drawer-me,
  :root[data-f] .reading-head a {
    font-family: var(--head);
    font-weight: var(--head-weight);
    letter-spacing: var(--head-spacing);
  }
  :root[data-f='5'] .prose .title h1 {
    font-size: 1.875rem;
  }
  :root[data-f='5'] .entry .title {
    font-size: 1.25rem;
  }
</style>
