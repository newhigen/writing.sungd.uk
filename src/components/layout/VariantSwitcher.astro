---
// 시안 스위처(임시). 고르고 나면 지운다. 판(data-l)은 골격, 색(data-v)은 느낌.
const layouts = [
  ['0', '기본'],
  ['1', '위 차림표'],
  ['2', '두 단'],
  ['3', '접은 서랍'],
  ['4', '오른쪽 차림표'],
  ['5', '히트맵 옆에'],
  ['6', '한 흐름'],
  ['7', '첫 글 크게']
]
const colors = [
  ['a', '기본'],
  ['b', '먹'],
  ['c', '종이'],
  ['d', '밤'],
  ['e', '코발트'],
  ['f', '크게'],
  ['g', '색인']
]
---

<div class="v-switch" aria-label="시안 고르기">
  <div class="v-row">
    <span>판</span>
    {
      layouts.map(([key, label]) => (
        <button type="button" data-l={key} title={label}>
          {key}
        </button>
      ))
    }
  </div>
  <div class="v-row">
    <span>색</span>
    {
      colors.map(([key, label]) => (
        <button type="button" data-v={key} title={label}>
          {key}
        </button>
      ))
    }
  </div>
</div>

<script is:inline>
  ;(function () {
    var html = document.documentElement
    var q = new URLSearchParams(location.search)
    function read(key, fallback) {
      var v = q.get(key)
      if (!v) {
        try {
          v = localStorage.getItem('sd-' + key)
        } catch (e) {}
      }
      return v || fallback
    }
    function apply(key, val) {
      html.dataset[key] = val
      try {
        localStorage.setItem('sd-' + key, val)
      } catch (e) {}
      if (key === 'l') applyLayout(val)
      paint()
    }
    function applyLayout(val) {
      var secs = document.querySelectorAll('.drawers .sec')
      secs.forEach(function (s, i) {
        s.classList.toggle('open', val === '3' && s.id === '글')
      })
      var f = document.querySelector('.only-featured')
      if (f) {
        var dup = document.querySelector('.sec-list li[data-id="' + f.dataset.id + '"]')
        if (dup) dup.style.display = val === '7' ? 'none' : ''
      }
    }
    function paint() {
      document.querySelectorAll('.v-switch button').forEach(function (b) {
        var key = b.dataset.l !== undefined ? 'l' : 'v'
        b.classList.toggle('on', b.dataset[key] === html.dataset[key])
      })
    }
    function bind() {
      applyLayout(html.dataset.l)
      paint()
      document.querySelectorAll('.v-switch button').forEach(function (b) {
        if (b.dataset.bound) return
        b.dataset.bound = '1'
        b.addEventListener('click', function () {
          if (b.dataset.l !== undefined) apply('l', b.dataset.l)
          else apply('v', b.dataset.v)
        })
      })
      document.querySelectorAll('.drawers .sec-head').forEach(function (h) {
        if (h.dataset.bound) return
        h.dataset.bound = '1'
        h.addEventListener('click', function () {
          if (html.dataset.l === '3') h.parentElement.classList.toggle('open')
        })
      })
    }
    apply('v', read('v', 'a'))
    apply('l', read('l', '0'))
    bind()
    document.addEventListener('astro:page-load', bind)
  })()
</script>
