---
// 임시: 목차(t)·요소(e) 시안 전환기. 고르면 지운다.
---

<div class="psw" aria-label="시안 전환">
  <div class="psw-row">
    <span>목차</span>
    <button data-k="t" data-v="">오른쪽 여백</button>
    <button data-k="t" data-v="2">차림표 아래</button>
    <button data-k="t" data-v="3">제목 아래 접기</button>
  </div>
  <div class="psw-row">
    <span>요소</span>
    <button data-k="e" data-v="">지금</button>
    <button data-k="e" data-v="1">가 조용히</button>
    <button data-k="e" data-v="2">나 책장</button>
  </div>
</div>

<script is:inline>
  ;(() => {
    const keys = ['t', 'e']
    const params = new URLSearchParams(location.search)
    const state = {}
    for (const k of keys) {
      const q = params.get(k)
      state[k] = q !== null ? q : localStorage.getItem('sd-' + k) || ''
    }
    const apply = () => {
      for (const k of keys) {
        if (state[k]) document.documentElement.dataset[k] = state[k]
        else delete document.documentElement.dataset[k]
      }
      document
        .querySelectorAll('.psw button')
        .forEach((b) => b.classList.toggle('on', state[b.dataset.k] === b.dataset.v))
    }
    apply()
    document.addEventListener('astro:page-load', () => {
      apply()
      document.querySelectorAll('.psw button').forEach((b) =>
        b.addEventListener('click', () => {
          state[b.dataset.k] = b.dataset.v
          localStorage.setItem('sd-' + b.dataset.k, b.dataset.v)
          apply()
        })
      )
    })
  })()
</script>

<style is:global>
  .psw {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.3rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    z-index: 20;
    font-family: system-ui, sans-serif;
  }
  .psw-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .psw-row span {
    width: 2.25rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }
  .psw button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 0.3rem;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .psw button.on {
    background: var(--text-primary);
    color: var(--bg);
  }

  /* 새로 넣은 요소는 기본으로 숨긴다 */
  .foot-text,
  .drawer-foot,
  .entry-note {
    display: none;
  }

  /* ════ 가 · 조용히 — 선·면을 걷어내고 흐린 글자로만 층을 낸다 ════ */

  /* 인용: 왼쪽 막대 대신 들여쓰기와 흐린 글자 */
  html:root[data-e='1'] .prose blockquote {
    border-left: none;
    margin-left: 0;
    padding-left: 1.25rem;
    color: var(--text-secondary);
  }

  /* 표: 둥근 테두리·머리줄 칠을 빼고 행 사이 가는 줄만 */
  html:root[data-e='1'] .prose table {
    border: none;
    border-radius: 0;
  }
  html:root[data-e='1'] .prose th,
  html:root[data-e='1'] .prose td {
    border-right: none;
    padding: 0.55em 1em 0.55em 0;
  }
  html:root[data-e='1'] .prose th {
    background: none;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-secondary);
  }

  /* 참조: 짧은 가로선 없이, 작고 흐린 목록 */
  html:root[data-e='1'] .prose .footnotes::before {
    display: none;
  }
  html:root[data-e='1'] .prose .footnotes::after {
    top: 0;
    font-size: 0.8125rem;
    opacity: 1;
    color: var(--text-secondary);
  }
  html:root[data-e='1'] .prose .footnotes {
    padding-top: 1.75rem;
  }
  html:root[data-e='1'] .prose .footnotes li,
  html:root[data-e='1'] .prose .footnotes li * {
    font-size: 0.8125rem;
  }
  html:root[data-e='1'] .prose .footnotes a:not([data-footnote-backref]) {
    color: var(--text-secondary);
    text-decoration-color: var(--text-tertiary);
  }
  html:root[data-e='1'] .prose [data-footnote-backref] {
    display: none;
  }
  html:root[data-e='1'] .prose [data-footnote-ref] {
    color: var(--accent);
  }

  /* 꼬리말: 영어·아이콘 대신 한국어 글자 링크 */
  html:root[data-e='1'] footer .site-links,
  html:root[data-e='1'] footer .social-links {
    display: none;
  }
  html:root[data-e='1'] .foot-text {
    display: flex;
    flex: 1;
    gap: 1rem;
  }
  html:root[data-e='1'] .foot-text a {
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    text-decoration: none;
  }
  html:root[data-e='1'] .foot-text a:hover {
    color: var(--text-secondary);
  }
  html:root[data-e='1'] .foot-gap {
    flex: 1;
  }

  /* 독서 기록·영화: 해는 제목 글꼴, 달은 첫 화면처럼 왼쪽 칸, 글이 있는 항목은 강조색 */
  html:root[data-e='1'] .year-name {
    font-family: var(--head);
  }
  html:root[data-e='1'] .book-month,
  html:root[data-e='1'] .movie-month {
    width: 3rem;
    text-align: left;
    font-size: 0.75rem;
  }
  html:root[data-e='1'] .book-entry,
  html:root[data-e='1'] .movie-entry {
    gap: 0;
  }
  html:root[data-e='1'] .book-title.linked,
  html:root[data-e='1'] .movie-title.linked {
    text-decoration: none;
    color: var(--accent);
  }

  /* 히트맵 툴팁: 그림자 없이 */
  html:root[data-e='1'] .heat-tip,
  html:root[data-e='2'] .heat-tip {
    box-shadow: none;
  }

  /* ════ 나 · 책장 — 책에서 가져온 표기: 명조 인용, 여백의 번호, 차림표 아래 꼬리말 ════ */

  /* 인용: 막대 없이 명조로, 여는 따옴표를 왼쪽 여백에 */
  html:root[data-e='2'] .prose blockquote {
    position: relative;
    border-left: none;
    margin-left: 0;
    padding-left: 1.5rem;
    font-family: var(--head);
    font-weight: 400;
  }
  html:root[data-e='2'] .prose blockquote::before {
    content: '“';
    position: absolute;
    left: 0;
    top: -0.1em;
    font-family: var(--head);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--text-tertiary);
  }
  html:root[data-e='2'] .prose blockquote strong {
    font-family: var(--head);
  }

  /* 표: 줄 없이 여백으로만, 머리줄은 명조 */
  html:root[data-e='2'] .prose table {
    border: none;
    border-radius: 0;
  }
  html:root[data-e='2'] .prose th,
  html:root[data-e='2'] .prose td {
    border: none;
    padding: 0.5em 1.25em 0.5em 0;
    vertical-align: top;
  }
  html:root[data-e='2'] .prose th {
    background: none;
    font-family: var(--head);
  }
  html:root[data-e='2'] .prose tr:nth-child(even) td {
    background: var(--code-bg);
  }

  /* 참조: 번호는 흐리게, 글자는 본문색, 밑줄 없이 */
  html:root[data-e='2'] .prose .footnotes::before {
    display: none;
  }
  html:root[data-e='2'] .prose .footnotes::after {
    top: 0;
    font-family: var(--head);
    font-size: 0.875rem;
    opacity: 1;
    color: var(--text-secondary);
  }
  html:root[data-e='2'] .prose .footnotes {
    padding-top: 2rem;
  }
  html:root[data-e='2'] .prose .footnotes li,
  html:root[data-e='2'] .prose .footnotes li * {
    font-size: 0.8125rem;
  }
  html:root[data-e='2'] .prose .footnotes a:not([data-footnote-backref]) {
    color: var(--text-primary);
    text-decoration: none;
  }
  html:root[data-e='2'] .prose .footnotes a:not([data-footnote-backref]):hover {
    color: var(--accent);
  }
  html:root[data-e='2'] .prose [data-footnote-backref] {
    color: var(--text-tertiary);
  }
  html:root[data-e='2'] .prose [data-footnote-ref] {
    color: var(--accent);
  }

  /* 꼬리말: 글 칸 아래에서 빼고 차림표 아래로 */
  html:root[data-e='2'] footer {
    display: none;
  }
  html:root[data-e='2'] .drawer-foot {
    display: flex;
    flex-direction: column;
    margin-top: 1.25rem;
  }
  html:root[data-e='2'] .drawer-foot a {
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--text-tertiary);
    text-decoration: none;
  }
  html:root[data-e='2'] .drawer-foot a:hover {
    color: var(--text-secondary);
  }

  /* 독서 기록·영화: 해는 첫 화면처럼 작게, 글이 있는 항목 뒤에 「서평」「글」 */
  html:root[data-e='2'] .year-name {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-secondary);
  }
  html:root[data-e='2'] .book-month,
  html:root[data-e='2'] .movie-month {
    width: 3rem;
    text-align: left;
    font-size: 0.75rem;
  }
  html:root[data-e='2'] .book-entry,
  html:root[data-e='2'] .movie-entry {
    gap: 0;
  }
  html:root[data-e='2'] .book-title.linked,
  html:root[data-e='2'] .movie-title.linked {
    text-decoration: none;
  }
  html:root[data-e='2'] .book-title.linked:hover,
  html:root[data-e='2'] .movie-title.linked:hover {
    color: var(--accent);
  }
  html:root[data-e='2'] .entry-note {
    display: inline;
    flex: none;
    margin-left: 0.5rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }
</style>
