---
// 임시: 인용문(q) 시안 전환기. 고르면 지운다.
---

<div class="psw" aria-label="시안 전환">
  <div class="psw-row">
    <span>인용</span>
    <button data-k="q" data-v="">형광펜</button>
    <button data-k="q" data-v="2">연필 밑줄</button>
    <button data-k="q" data-v="3">옅은 면</button>
    <button data-k="q" data-v="4">강조색 글자</button>
  </div>
</div>

<script is:inline>
  ;(() => {
    const keys = ['q']
    const params = new URLSearchParams(location.search)
    const state = {}
    for (const k of keys) {
      const q = params.get(k)
      state[k] = q !== null ? q : localStorage.getItem('sd-' + k) || ''
    }
    const apply = () => {
      for (const k of keys) {
        if (state[k]) document.documentElement.dataset[k] = state[k]
        else delete document.documentElement.dataset[k]
      }
      document
        .querySelectorAll('.psw button')
        .forEach((b) => b.classList.toggle('on', state[b.dataset.k] === b.dataset.v))
    }
    apply()
    document.addEventListener('astro:page-load', () => {
      apply()
      document.querySelectorAll('.psw button').forEach((b) =>
        b.addEventListener('click', () => {
          state[b.dataset.k] = b.dataset.v
          localStorage.setItem('sd-' + b.dataset.k, b.dataset.v)
          apply()
        })
      )
    })
  })()
</script>

<style is:global>
  .psw {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.3rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    z-index: 20;
    font-family: system-ui, sans-serif;
  }
  .psw-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }
  .psw-row span {
    width: 2.25rem;
    font-size: 0.6875rem;
    color: var(--text-tertiary);
  }
  .psw button {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border: none;
    border-radius: 0.3rem;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .psw button.on {
    background: var(--text-primary);
    color: var(--bg);
  }

  /* 형광펜: 책에 그어 둔 형광펜처럼 글줄 아래쪽 반에 옅은 강조색 */
  html:not([data-q]) .prose blockquote p {
    display: inline;
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--accent) 20%, transparent) 58% 92%,
      transparent 92%
    );
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  html:not([data-q]) .prose blockquote p + p::before {
    content: '';
    display: block;
    height: 0.5em;
  }

  /* 연필 밑줄: 가는 강조색 밑줄 */
  html[data-q='2'] .prose blockquote p {
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    text-decoration-skip-ink: none;
  }

  /* 옅은 면: 종이 위에 붙인 쪽지처럼 옅은 바탕 */
  html[data-q='3'] .prose blockquote {
    padding: 0.75rem 1rem;
    background: var(--code-bg);
    border-radius: 0.25rem;
  }

  /* 강조색 글자 */
  html[data-q='4'] .prose blockquote {
    color: var(--accent);
  }
</style>
