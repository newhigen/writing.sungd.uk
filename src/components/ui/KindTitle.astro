---
// 서평 제목 표시 시안 (임시 — 고르면 하나만 남긴다)
// k=1 제목 뒤 책 아이콘 · k=2 『』 · k=3 여백 칸 아이콘(여백 쪽 아이콘은 HomeSentences 에서 넣는다)
interface Props {
  title: string
  review: boolean
}

const { title, review } = Astro.props
---

{
  review ? (
    <span class="kt">
      {title}
      <svg class="ki" viewBox="0 0 16 16" aria-label="서평" role="img">
        <path d="M8 4.2C6.6 3.2 4.6 2.9 2.5 3.2v9c2.1-.3 4.1 0 5.5 1 1.4-1 3.4-1.3 5.5-1v-9c-2.1-.3-4.1 0-5.5 1Zm0 0v9" />
      </svg>
    </span>
  ) : (
    title
  )
}

<style is:global>
  .ki,
  .kg {
    display: none;
    fill: none;
    stroke: var(--text-tertiary);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  html[data-k='1'] .ki {
    display: inline;
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.4em;
    vertical-align: -0.08em;
  }

  html[data-k='2'] .kt::before,
  html[data-k='2'] .kt::after {
    color: var(--text-tertiary);
    font-weight: 400;
  }

  html[data-k='2'] .kt::before {
    content: '『';
  }

  html[data-k='2'] .kt::after {
    content: '』';
  }

  html[data-k='3'] .kg {
    display: block;
    width: 0.875rem;
    height: 0.875rem;
    margin-top: 0.3rem;
  }

  html[data-k='3'] .tail .kg {
    display: inline;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 0.3em;
    vertical-align: -0.1em;
  }
</style>
