---
// 서평이면 제목 뒤에 흐린 책 아이콘을 붙인다
interface Props {
  title: string
  review: boolean
}

const { title, review } = Astro.props
---

{title}
{
  review && (
    <svg class="review-mark" viewBox="0 0 16 16" aria-label="서평" role="img">
      <path d="M8 4.2C6.6 3.2 4.6 2.9 2.5 3.2v9c2.1-.3 4.1 0 5.5 1 1.4-1 3.4-1.3 5.5-1v-9c-2.1-.3-4.1 0-5.5 1Zm0 0v9" />
    </svg>
  )
}

<style>
  .review-mark {
    display: inline;
    font-size: inherit;
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.4em;
    vertical-align: -0.08em;
    fill: none;
    stroke: var(--text-tertiary);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
</style>
