---
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import DrawerFrame from '@/components/layout/DrawerFrame.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

const { title, description } = Astro.props
---

<BaseLayout title={title} description={description} type="page">
  <BaseHead title={title} description={description} slot="head" />
  <DrawerFrame active="글">
    <slot name="aside" slot="aside" />
    <slot />
  </DrawerFrame>
</BaseLayout>
