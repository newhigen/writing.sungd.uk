---
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'
---

<IndexLayout title={`404 · ${themeConfig.site.title}`} description="없는 페이지">
  <style>
    .error-container {
      color: var(--text-secondary);
    }
    .error-container a {
      color: var(--accent);
    }
  </style>
  <p class="error-container">없는 페이지예요. <a href="/">글 목록으로 가기</a></p>
</IndexLayout>
