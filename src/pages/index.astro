---
import IndexLayout from '@/layouts/IndexLayout.astro'
import BookStacks from '@/components/widgets/BookStacks.astro'
import HomeSentences from '@/components/home/HomeSentences.astro'
import { themeConfig } from '@/config'
import { loadBooks } from '@/utils/books'
import { getSortedFilteredPosts } from '@/utils/draft'

const posts = await getSortedFilteredPosts()
const bookCount = loadBooks().length
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <section class="reading reading-side" slot="aside">
    <h2 class="reading-head">
      <a href="/books">독서 기록</a>
      <em>{bookCount}권</em>
    </h2>
    <BookStacks compact />
  </section>
  <HomeSentences posts={posts} lead={6} tail={12}>
    <section class="reading reading-mid" slot="mid">
      <h2 class="reading-head">
        <a href="/books">독서 기록</a>
        <em>{bookCount}권</em>
      </h2>
      <BookStacks compact />
    </section>
  </HomeSentences>
</IndexLayout>

<style>
  /* 폰에선 책탑을 맨 위 대신 최근 글 뒤에 작게 둔다 */
  .reading-mid {
    display: none;
  }

  @media (max-width: 640px) {
    .reading-side {
      display: none;
    }

    .reading-mid {
      display: block;
      width: 13rem;
      margin: 1rem 0 0 3rem;
    }
  }

  .reading-head {
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-bold);
  }

  .reading-head a {
    font-family: var(--head);
    color: var(--text-primary);
    text-decoration: none;
  }

  .reading-head a:hover {
    color: var(--accent);
  }

  .reading-head em {
    font-style: normal;
    font-size: 0.7rem;
    font-weight: var(--font-weight-regular);
    color: var(--text-secondary);
    font-family: var(--num);
    font-variant-numeric: tabular-nums;
  }
</style>
