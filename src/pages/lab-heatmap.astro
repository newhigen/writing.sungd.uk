---
// 임시: 책탑 시안. 자리를 정하면 지운다.
import '@/styles/global.css'
import BaseHead from '@/components/layout/BaseHead.astro'
import DrawerFrame from '@/components/layout/DrawerFrame.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import BookStacks from '@/components/widgets/BookStacks.astro'
---

<BaseLayout title="책탑 시안" description="책탑 시안" type="page">
  <BaseHead title="책탑 시안" description="책탑 시안" slot="head" />
  <DrawerFrame active="독서 기록">
    <h1 class="lab-title">책탑</h1>
    <BookStacks />
  </DrawerFrame>
</BaseLayout>

<style>
  .lab-title {
    margin: 0 0 1.5rem;
    font-family: var(--head);
    font-size: var(--font-size-m);
  }
</style>
